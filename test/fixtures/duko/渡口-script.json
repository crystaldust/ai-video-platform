{
  "source": "渡口",
  "episodes": [
    {
      "id": "ep_mtg51p27",
      "ep": 1,
      "targetSeconds": 120,
      "hook": "皮箱里到底装了什么，值得她指节发白",
      "cliff": "陆行远的右手从上船起就没离开过大衣口袋",
      "beatsClaimed": [
        "悬念钩"
      ],
      "scenes": [
        {
          "id": "sc_x3xq2c82",
          "sceneId": "S02",
          "lighting": "浓雾清晨",
          "characters": [
            "C01",
            "C03",
            "C04"
          ],
          "props": [
            "P01"
          ],
          "flow": [
            {
              "id": "bt_1kx49vx4",
              "action": "冷开场：一个年轻女人抱着旧皮箱，在雾里的河岸土路上跑，鞋底踏得水洼直响，箱子搂得死紧。雾把她的背影吞掉。"
            },
            {
              "id": "bt_4ja0fjzn",
              "action": "跑到头，雾里才露出栈桥，只剩三步能见。老周把篙靠在船帮上，蹲在船头吧嗒旱烟，梆子声闷得像隔了层棉絮。"
            },
            {
              "id": "bt_64w7dn8y",
              "speaker": "C03",
              "line": "上船喽——过河的抓紧，雾要变天。",
              "delivery": "扯着嗓子，不急不躁"
            },
            {
              "id": "bt_4zzm3d4p",
              "action": "跳板尽头传来担子的响动，胡二爷挑着货担赶上来，嗓门比人先到。"
            },
            {
              "id": "bt_ptqckns6",
              "speaker": "C04",
              "line": "等等二爷我！这雾天赶船，命都得跑掉半条。",
              "delivery": "气喘吁吁，自来熟"
            },
            {
              "id": "bt_ejg03e6t",
              "action": "胡二爷挑着担子上船，老周搭手帮他把担子卸进舱里。"
            },
            {
              "id": "bt_jyr48wx2",
              "speaker": "C03",
              "line": "胡二爷，你这担子比人金贵。",
              "delivery": "旱烟不离嘴"
            },
            {
              "id": "bt_j34cndtc",
              "speaker": "C04",
              "line": "那可不——吃饭的家伙，比命金贵。",
              "delivery": "拍着担子笑"
            },
            {
              "id": "bt_a61jpe7x",
              "action": "沈知微最后一个踏上跳板。旧皮箱抱在怀里，指节因为用力而发白。"
            },
            {
              "id": "bt_pbk0qjcm",
              "speaker": "C03",
              "line": "箱子沉就搁船头，掉河里我可不捞。",
              "delivery": "眼皮都没抬"
            },
            {
              "id": "bt_7m1r2vhx",
              "speaker": "C01",
              "line": "不劳烦。它跟我。",
              "delivery": "声音很轻，却没商量"
            },
            {
              "id": "bt_kv41crgt",
              "action": "老周看了她一眼，没说话。他收了跳板，撑篙离岸，栈桥缩回雾里。"
            },
            {
              "id": "bt_2qngh62g",
              "speaker": "C03",
              "line": "坐稳——开船。",
              "delivery": "篙一点岸"
            }
          ]
        },
        {
          "id": "sc_rvnqh21s",
          "sceneId": "S01",
          "lighting": "晨雾",
          "characters": [
            "C01",
            "C02",
            "C03",
            "C04"
          ],
          "props": [
            "P01"
          ],
          "flow": [
            {
              "id": "bt_8m5e0m48",
              "action": "舱里坐着两个人。胡二爷的货担占了半条长凳，陆行远靠着舱壁，右手揣在大衣口袋里没动过。"
            },
            {
              "id": "bt_fmnn3tfa",
              "speaker": "C04",
              "line": "姑娘头回走这条水路吧？我一看一个准。",
              "delivery": "自来熟地凑近"
            },
            {
              "id": "bt_tzxfwhbh",
              "action": "沈知微拣了离所有人最远的角落坐下，皮箱搁在膝上，双臂环着。"
            },
            {
              "id": "bt_6y8jggjd",
              "speaker": "C04",
              "line": "城里亲戚接站，还是投店？二爷我熟门熟路。",
              "delivery": "追着问"
            },
            {
              "id": "bt_axx5fzv3",
              "speaker": "C01",
              "line": "借过就好，不敢劳动。",
              "delivery": "不抬眼"
            },
            {
              "id": "bt_4x9159y4",
              "speaker": "C04",
              "line": "嗨，出门在外别客气——箱子给我，搁上头稳当。",
              "delivery": "笑着，手已经伸向皮箱"
            },
            {
              "id": "bt_m8kr6z76",
              "action": "沈知微一把按住箱盖，动作快得吓人。"
            },
            {
              "id": "bt_jr5m1qh9",
              "action": "满舱的闲谈声戛然而止。胡二爷的手停在半空，笑僵在脸上。"
            },
            {
              "id": "bt_trke6r7h",
              "speaker": "C03",
              "line": "船上有个规矩——不问来路，不碰行李。",
              "delivery": "从船头传来，不紧不慢"
            },
            {
              "id": "bt_4azknjz8",
              "speaker": "C04",
              "line": "是是，二爷我多嘴，多嘴。",
              "delivery": "讪讪收手"
            },
            {
              "id": "bt_hd4q060j",
              "action": "船行河心，雾贴着水皮走。胡二爷东张西望，眼睛老往皮箱上瞟。"
            },
            {
              "id": "bt_m2ah7jcc",
              "speaker": "C04",
              "line": "老周，今儿这雾邪性，走得完吗？",
              "delivery": "没话找话"
            },
            {
              "id": "bt_mxk1f4pz",
              "speaker": "C03",
              "line": "走了四十年，没有走不完的河。",
              "delivery": "篙声不停"
            },
            {
              "id": "bt_stmz7ggk",
              "speaker": "C04",
              "line": "这位先生面生得很，也是去县城？",
              "delivery": "转头找新话头"
            },
            {
              "id": "bt_mvc3k0wc",
              "action": "陆行远点了点头，眼睛却看着舱外的雾，没接这个话头。"
            },
            {
              "id": "bt_w9j9c16c",
              "speaker": "C04",
              "line": "得，一船的闷葫芦，就我一个人长嘴。",
              "delivery": "自讨没趣"
            },
            {
              "id": "bt_bfj04m40",
              "action": "老周在船头笑了一声，没回头。水声在船底一下一下，像谁在数着到岸的时辰。"
            },
            {
              "id": "bt_7y83v229",
              "action": "陆行远从头到尾没看这场热闹，可他口袋里的右手，攥紧了一下。"
            },
            {
              "id": "bt_xm9abxds",
              "speaker": "C02",
              "line": "这条河，今晚怕是不太平。",
              "delivery": "低声，几乎自语"
            },
            {
              "id": "bt_ke47803c",
              "action": "汽笛在雾深处闷闷响了一声，没人接话。"
            },
            {
              "id": "bt_gaxbkbb0",
              "speaker": "VO",
              "line": "谁都别碰它。到了县城，它就是我全部的话。",
              "delivery": "沈知微的心声，冷"
            },
            {
              "id": "bt_1ec4a5yn",
              "action": "雾从舱口漫进来，皮箱上的铜扣绿锈在昏光里一闪。栈桥的灯缩成一粒黄豆，灭了。"
            }
          ]
        }
      ],
      "hookBeat": "bt_1kx49vx4"
    },
    {
      "id": "ep_vt1jgnz6",
      "ep": 2,
      "targetSeconds": 120,
      "hook": "陆行远为什么替一桩旧案说话",
      "cliff": "胡二爷讲见闻时，指名道姓提了沈家",
      "beatsClaimed": [],
      "scenes": [
        {
          "id": "sc_cbnhb36y",
          "sceneId": "S01",
          "lighting": "晨雾",
          "characters": [
            "C01",
            "C02",
            "C04"
          ],
          "props": [
            "P01"
          ],
          "flow": [
            {
              "id": "bt_fwa4sr7j",
              "action": "冷开场：船身猛一晃，陆行远的右手在大衣口袋里攥紧了什么，眼睛始终盯着雾外。船进了河心的雾档，胡二爷从货担里摸出一包炒豆，挨个让。"
            },
            {
              "id": "bt_31gz38sf",
              "speaker": "C04",
              "line": "尝尝？县城东街炒的，隔着雾都香。",
              "delivery": "殷勤"
            },
            {
              "id": "bt_hgewm4am",
              "action": "沈知微摇头。陆行远像没听见。胡二爷自己嚼上了，越嚼话越多。"
            },
            {
              "id": "bt_m039qr0g",
              "speaker": "C04",
              "line": "这趟进城你们可赶巧了，集市比年根还热闹。",
              "delivery": "眉飞色舞"
            },
            {
              "id": "bt_8kghf92y",
              "speaker": "C04",
              "line": "为啥？县衙在翻一桩十年前的旧案，全城都在看戏。",
              "delivery": "压低声音卖关子"
            },
            {
              "id": "bt_8yg0g1p7",
              "action": "他说着话，眼睛却直往沈知微怀里的皮箱看。"
            },
            {
              "id": "bt_kb6fsbhs",
              "action": "沈知微把箱子抱得更紧，头垂得更低。"
            },
            {
              "id": "bt_9cr4f7hf",
              "speaker": "C04",
              "line": "听说当年错杀了人，如今苦主的后人要翻案。",
              "delivery": "咂着嘴"
            },
            {
              "id": "bt_ewrk4mnz",
              "speaker": "C04",
              "line": "沈家啊——城里老户，说没就没了大半门。",
              "delivery": "叹一声，眼却瞟着皮箱"
            },
            {
              "id": "bt_76b2eppe",
              "action": "沈字一出口，舱里静了一瞬。沈知微垂着头，肩膀绷紧了。"
            },
            {
              "id": "bt_v0m7n5ca",
              "speaker": "C02",
              "line": "那案子，查错了人。",
              "delivery": "突然开口"
            },
            {
              "id": "bt_1v1k6rdj",
              "action": "满舱静了。胡二爷嚼豆的嘴停在半空。"
            },
            {
              "id": "bt_3m7p9ctq",
              "speaker": "C04",
              "line": "哟，先生知道内情？",
              "delivery": "眯起眼"
            },
            {
              "id": "bt_hew7rdsj",
              "speaker": "C02",
              "line": "卷宗我读过。人证是屈打成招，物证对不上。",
              "delivery": "语气平得像念书"
            },
            {
              "id": "bt_pfdyzt4v",
              "speaker": "C04",
              "line": "卷宗那是衙门里的东西，先生贵姓？",
              "delivery": "笑里藏针"
            },
            {
              "id": "bt_4aee0ykc",
              "action": "陆行远不答。右手在大衣口袋里，轻轻动了一下。"
            },
            {
              "id": "bt_1cxd6m8g",
              "speaker": "C02",
              "line": "姓什么不要紧。要紧的是错案就是错案。",
              "delivery": "不接招"
            },
            {
              "id": "bt_15wvxc57",
              "action": "沈知微抬起头，第一次正眼看向这个沉默的男人。"
            },
            {
              "id": "bt_ty047e4b",
              "speaker": "VO",
              "line": "他是谁？他为什么替沈家说话？",
              "delivery": "沈知微的心声"
            },
            {
              "id": "bt_xp0zdeyx",
              "speaker": "C04",
              "line": "姑娘也姓沈？我瞧你上船就没说过几句话。",
              "delivery": "冷不丁转向她"
            },
            {
              "id": "bt_dwgzvcz0",
              "speaker": "C01",
              "line": "出门人，姓什么都是过客。",
              "delivery": "平静得过了头"
            },
            {
              "id": "bt_g98qyya1",
              "speaker": "C04",
              "line": "好好好，是二爷我多问。",
              "delivery": "拍腿笑"
            },
            {
              "id": "bt_ab70hakp",
              "action": "他笑着，身子却往沈知微那边又挪了半条凳。"
            },
            {
              "id": "bt_dgn7zc6h",
              "speaker": "C02",
              "line": "胡老板，你的豆撒了。",
              "delivery": "淡淡地"
            },
            {
              "id": "bt_p8s5zc8x",
              "action": "胡二爷低头去捡豆，挪过去的半条凳又缩了回来。"
            },
            {
              "id": "bt_7nh5p1cx",
              "speaker": "C04",
              "line": "邪性，今儿这船上人人都护着人人。",
              "delivery": "捡着豆嘟囔"
            },
            {
              "id": "bt_c12tptva",
              "action": "篙声从船头传来，一下，又一下，稳得让人心慌。"
            },
            {
              "id": "bt_wjstv6nv",
              "speaker": "C04",
              "line": "你们说句公道话，那旧案到底冤不冤？",
              "delivery": "不死心"
            },
            {
              "id": "bt_q3yvyb11",
              "action": "没人回答，只有篙点进水里的闷响。"
            },
            {
              "id": "bt_s6g7at98",
              "speaker": "C04",
              "line": "得，问了也白问——这船上的规矩，不问来路。",
              "delivery": "自己接上"
            },
            {
              "id": "bt_r25jq030",
              "speaker": "C02",
              "line": "也不问去处。",
              "delivery": "低声补了半句"
            },
            {
              "id": "bt_jkp4jn6x",
              "action": "陆行远说完这四个字，目光落回舱外。雾里隐约有另一条船的影子，一晃就没了。"
            },
            {
              "id": "bt_py903f69",
              "speaker": "VO",
              "line": "一个护箱的，一个懂案的，这船有意思了。",
              "delivery": "胡二爷的心声，算盘声"
            },
            {
              "id": "bt_arqmsc8x",
              "action": "沈知微顺着他的目光看向雾里，什么都没看见，抱箱的手又紧了紧。"
            }
          ]
        }
      ],
      "hookBeat": "bt_fwa4sr7j"
    },
    {
      "id": "ep_t4vnthc9",
      "ep": 3,
      "targetSeconds": 120,
      "hook": "县衙的砚台为什么在他身上",
      "cliff": "巡查船的汽笛越来越近，老周却把船往雾更深处撑",
      "beatsClaimed": [
        "身份揭破"
      ],
      "scenes": [
        {
          "id": "sc_bmg7t4yn",
          "sceneId": "S01",
          "lighting": "晨雾",
          "characters": [
            "C01",
            "C02",
            "C03",
            "C04"
          ],
          "props": [
            "P01",
            "P02"
          ],
          "flow": [
            {
              "id": "bt_8d8cwpgs",
              "action": "冷开场：一声汽笛从雾里剜出来，陆行远的手猛地按住大衣口袋——那里鼓着一块方硬的轮廓。满舱的人都直了背。"
            },
            {
              "id": "bt_pthjvm3n",
              "speaker": "C04",
              "line": "听听，这动静——巡查的船。",
              "delivery": "竖起耳朵"
            },
            {
              "id": "bt_m9hwmjmz",
              "speaker": "C03",
              "line": "商船改的巡查船，烧的煤不一样，听声就知道。",
              "delivery": "从船头，声音没起伏"
            },
            {
              "id": "bt_fbzn8f7k",
              "action": "老周说着，篙却往雾更深的地方点。船身一偏，离了主航道。"
            },
            {
              "id": "bt_pmg8ktpb",
              "speaker": "C04",
              "line": "老周哥这是躲啊？咱船上又没人揣着硬家伙。",
              "delivery": "嗓门故意抬高"
            },
            {
              "id": "bt_zkn5qzth",
              "action": "舱里一下没了声。胡二爷笑着，眼睛盯住了陆行远的大衣口袋。"
            },
            {
              "id": "bt_vawb9wrp",
              "speaker": "C04",
              "line": "先生，你说是不是？这年头查得严，说不清可就麻烦了。",
              "delivery": "步步紧逼"
            },
            {
              "id": "bt_hd5afvsc",
              "action": "满舱的目光跟着聚过去。那只从上船就没露过面的右手，正揣在口袋里。"
            },
            {
              "id": "bt_eg3reg7n",
              "action": "沈知微也在看。她自己抱着箱子，最懂被人盯着的滋味，可她还是看了。"
            },
            {
              "id": "bt_fp8km9kk",
              "speaker": "C03",
              "line": "胡二爷，船上的规矩。",
              "delivery": "声音沉了下来"
            },
            {
              "id": "bt_6shk2wpy",
              "speaker": "C04",
              "line": "规矩是不问来路——可没说不问口袋。汽笛在催了。",
              "delivery": "摊着手"
            },
            {
              "id": "bt_35jhzkmz",
              "action": "汽笛又是一声，近得能听出船头破水的哗声。"
            },
            {
              "id": "bt_8h7288jc",
              "speaker": "C02",
              "line": "好。",
              "delivery": "很轻地笑了一下"
            },
            {
              "id": "bt_z668jepf",
              "action": "陆行远站起身。右手从口袋里抽出来的那一瞬，半船人屏住了呼吸。"
            },
            {
              "id": "bt_sbqbhr4n",
              "action": "摊开的手心里没有枪。是一方旧砚，砚身乌沉，边角磕出了茬口。"
            },
            {
              "id": "bt_md5jtyhs",
              "speaker": "C04",
              "line": "砚台？先生你揣块砚台过河？",
              "delivery": "愣住"
            },
            {
              "id": "bt_27j4rsa7",
              "speaker": "C02",
              "line": "物归原主。就这四个字，多的没有。",
              "delivery": "把砚举到光下"
            },
            {
              "id": "bt_0qqkqxj4",
              "action": "他把砚翻过来。砚底一方刻印，在昏光里露出笔画——县衙的印。"
            },
            {
              "id": "bt_1qejg1mk",
              "speaker": "VO",
              "line": "县衙的东西，在一个不肯报姓的人手里。",
              "delivery": "胡二爷的心声"
            },
            {
              "id": "bt_cepk86q3",
              "speaker": "C01",
              "line": "这砚……是县衙大堂的？",
              "delivery": "声音发紧"
            },
            {
              "id": "bt_pwx4smec",
              "speaker": "C02",
              "line": "姑娘认得？",
              "delivery": "看她一眼"
            },
            {
              "id": "bt_g70tbm0a",
              "action": "沈知微抱紧箱子别开脸，像是刚才那句话不是她问的。"
            },
            {
              "id": "bt_tr45qrbk",
              "speaker": "C04",
              "line": "认不认得不打紧，打紧的是巡查船来了怎么说。",
